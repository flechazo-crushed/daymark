<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:scaleX="1.10"
        android:scaleY="1.10"
        android:src="@drawable/home_image" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#73000000" />

    <LinearLayout
        android:id="@+id/lock_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="68dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="0.75" />

        <TextView
            android:id="@+id/lock_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/daymark_font_family"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lock_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/daymark_font_family"
            android:gravity="center"
            android:textColor="#D9FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/lock_error"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/daymark_font_family"
            android:gravity="center"
            android:textColor="#FFFFB4AB"
            android:textSize="14sp"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/lock_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/lock_dot_1"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_lock_dot" />

            <View
                android:id="@+id/lock_dot_2"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_lock_dot" />

            <View
                android:id="@+id/lock_dot_3"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_lock_dot" />

            <View
                android:id="@+id/lock_dot_4"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_lock_dot" />

            <View
                android:id="@+id/lock_dot_5"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_lock_dot" />

            <View
                android:id="@+id/lock_dot_6"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_lock_dot" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="0.55" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/lock_key_1"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="7dp"
                    android:background="@drawable/bg_lock_key"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/daymark_font_family"
                    android:tag="1"
                    android:text="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="27sp" />

                <Button
                    android:id="@+id/lock_key_2"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="7dp"
                    android:background="@drawable/bg_lock_key"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/daymark_font_family"
                    android:tag="2"
                    android:text="2"
                    android:textColor="#FFFFFFFF"
                    android:textSize="27sp" />

                <Button
                    android:id="@+id/lock_key_3"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="7dp"
                    android:background="@drawable/bg_lock_key"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/daymark_font_family"
                    android:tag="3"
                    android:text="3"
                    android:textColor="#FFFFFFFF"
                    android:textSize="27sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/lock_key_4"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="7dp"
                    android:background="@drawable/bg_lock_key"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/daymark_font_family"
                    android:tag="4"
                    android:text="4"
                    android:textColor="#FFFFFFFF"
                    android:textSize="27sp" />

                <Button
                    android:id="@+id/lock_key_5"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="7dp"
                    android:background="@drawable/bg_lock_key"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/daymark_font_family"
                    android:tag="5"
                    android:text="5"
                    android:textColor="#FFFFFFFF"
                    android:textSize="27sp" />

                <Button
                    android:id="@+id/lock_key_6"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="7dp"
                    android:background="@drawable/bg_lock_key"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/daymark_font_family"
                    android:tag="6"
                    android:text="6"
                    android:textColor="#FFFFFFFF"
                    android:textSize="27sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/lock_key_7"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="7dp"
                    android:background="@drawable/bg_lock_key"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/daymark_font_family"
                    android:tag="7"
                    android:text="7"
                    android:textColor="#FFFFFFFF"
                    android:textSize="27sp" />

                <Button
                    android:id="@+id/lock_key_8"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="7dp"
                    android:background="@drawable/bg_lock_key"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/daymark_font_family"
                    android:tag="8"
                    android:text="8"
                    android:textColor="#FFFFFFFF"
                    android:textSize="27sp" />

                <Button
                    android:id="@+id/lock_key_9"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="7dp"
                    android:background="@drawable/bg_lock_key"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/daymark_font_family"
                    android:tag="9"
                    android:text="9"
                    android:textColor="#FFFFFFFF"
                    android:textSize="27sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Space
                    android:layout_width="86dp"
                    android:layout_height="86dp" />

                <Button
                    android:id="@+id/lock_key_0"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="7dp"
                    android:background="@drawable/bg_lock_key"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/daymark_font_family"
                    android:tag="0"
                    android:text="0"
                    android:textColor="#FFFFFFFF"
                    android:textSize="27sp" />

                <Button
                    android:id="@+id/lock_key_delete"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_margin="7dp"
                    android:background="@drawable/bg_lock_key"
                    android:backgroundTint="@null"
                    android:contentDescription="@string/lock_delete"
                    android:fontFamily="@font/daymark_font_family"
                    android:text="DEL"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="0.55" />
    </LinearLayout>
</FrameLayout>
