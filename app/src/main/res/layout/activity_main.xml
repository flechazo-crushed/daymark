<?xml version="1.0" encoding="utf-8"?>
<com.VoidSoul.daymark.CountdownView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:scaleX="1.03"
        android:scaleY="1.03"
        android:src="@drawable/home_image" />

    <View
        android:id="@+id/background_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#52000000" />

    <com.example.liquidglass.LiquidGlassView
        android:id="@+id/glass_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:adaptiveTint="true"
        app:bevelWidth="28dp"
        app:cornerRadius="28dp"
        app:dispersionStrength="0.06"
        app:glassMaterial="regular"
        app:refractionHeight="14dp"
        app:sensorHighlight="false">

        <com.VoidSoul.daymark.CountdownCardView
            android:id="@+id/countdown_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

    </com.example.liquidglass.LiquidGlassView>

    <com.VoidSoul.daymark.ModeSwitchView
        android:id="@+id/switch_glass"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/glass_switch_background"
        android:clickable="true"
        android:clipToOutline="true"
        android:contentDescription="切换倒计时"
        android:focusable="true">

        <View
            android:id="@+id/switch_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glass_switch_thumb"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/switch_together"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="在一起"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/switch_little_fool"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="小傻瓜"
                android:textColor="#BFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/switch_wood"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="木头"
                android:textColor="#BFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.VoidSoul.daymark.ModeSwitchView>

    <TextView
        android:id="@+id/love_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="true"
        android:text="爱你的日期"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

</com.VoidSoul.daymark.CountdownView>
