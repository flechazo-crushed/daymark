<?xml version="1.0" encoding="utf-8"?>
<com.VoidSoul.daymark.CountdownView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:scaleX="1.03"
        android:scaleY="1.03"
        android:src="@drawable/home_image" />

    <View
        android:id="@+id/background_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#52000000" />

    <com.example.liquidglass.LiquidGlassView
        android:id="@+id/glass_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:adaptiveTint="true"
        app:bevelWidth="28dp"
        app:cornerRadius="28dp"
        app:dispersionStrength="0.1"
        app:glassMaterial="regular"
        app:refractionHeight="18dp"
        app:sensorHighlight="true">

        <com.VoidSoul.daymark.CountdownCardView
            android:id="@+id/countdown_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

    </com.example.liquidglass.LiquidGlassView>

    <com.example.liquidglass.LiquidGlassView
        android:id="@+id/switch_glass"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:contentDescription="切换"
        android:focusable="true"
        app:adaptiveTint="true"
        app:bevelWidth="12dp"
        app:cornerRadius="18dp"
        app:dispersionStrength="0.1"
        app:glassMaterial="regular"
        app:refractionHeight="10dp"
        app:sensorHighlight="true">

        <TextView
            android:id="@+id/switch_label"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="切换"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </com.example.liquidglass.LiquidGlassView>

    <TextView
        android:id="@+id/love_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="true"
        android:text="爱你的日期"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

</com.VoidSoul.daymark.CountdownView>
