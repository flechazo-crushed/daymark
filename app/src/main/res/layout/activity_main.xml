<?xml version="1.0" encoding="utf-8"?>
<com.VoidSoul.daymark.CountdownView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout
        android:id="@+id/glass_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/background_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:scaleX="1.10"
            android:scaleY="1.10"
            android:src="@drawable/home_image" />

        <View
            android:id="@+id/background_dim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#52000000" />

    </FrameLayout>

    <com.example.liquidglass.LiquidGlassView
        android:id="@+id/glass_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:adaptiveTint="true"
        app:bevelWidth="28dp"
        app:backdropSourceId="@id/glass_backdrop"
        app:cornerRadius="28dp"
        app:dispersionStrength="0.06"
        app:glassMaterial="regular"
        app:refractionHeight="14dp"
        app:sensorHighlight="false">

        <com.VoidSoul.daymark.CountdownCardView
            android:id="@+id/countdown_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

    </com.example.liquidglass.LiquidGlassView>

    <com.example.liquidglass.LiquidGlassTabBar
        android:id="@+id/switch_glass"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="切换倒计时"
        app:adaptiveTint="true"
        app:backdropSourceId="@id/glass_backdrop"
        app:bevelWidth="16dp"
        app:cornerRadius="26dp"
        app:dispersionStrength="0.04"
        app:glassMaterial="regular"
        app:refractionHeight="8dp"
        app:sensorHighlight="false" />

    <com.example.liquidglass.LiquidGlassView
        android:id="@+id/more_glass"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:adaptiveTint="true"
        app:backdropSourceId="@id/glass_backdrop"
        app:bevelWidth="10dp"
        app:cornerRadius="20dp"
        app:dispersionStrength="0.04"
        app:glassMaterial="regular"
        app:refractionHeight="6dp"
        app:sensorHighlight="false">

        <FrameLayout
            android:id="@+id/more_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="更多选项">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⋮"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp" />
        </FrameLayout>
    </com.example.liquidglass.LiquidGlassView>

    <com.example.liquidglass.LiquidGlassView
        android:id="@+id/quote_glass"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:adaptiveTint="true"
        app:bevelWidth="16dp"
        app:backdropSourceId="@id/glass_backdrop"
        app:cornerRadius="22dp"
        app:dispersionStrength="0.04"
        app:glassMaterial="regular"
        app:refractionHeight="8dp"
        app:sensorHighlight="false">

        <TextView
            android:id="@+id/remote_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:fontFamily="@font/daymark_font_family"
            android:visibility="gone" />
    </com.example.liquidglass.LiquidGlassView>

</com.VoidSoul.daymark.CountdownView>
